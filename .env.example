# ========================================
# Application
# ========================================

NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ========================================
# Database
# ========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/product_scout


# ========================================
# Redis
# ========================================

REDIS_URL=redis://localhost:6379


# ========================================
# LLM
# ========================================

LLM_PROVIDER=deepseek

LLM_API_KEY=

LLM_BASE_URL=https://api.yunqiao.me


# ========================================
# Web Search
# ========================================

# Real search: agent-web-search-mcp (keyless), brave, or tavily. No mock fallback.
SEARCH_PROVIDER=agent-web-search-mcp

# Installed MCP executable, or its absolute path. Not a shell command.
SEARCH_MCP_COMMAND=agent-web-search-mcp

# Used only by brave/tavily; ignored by the keyless MCP adapter.
SEARCH_API_KEY=

# Brave/Tavily only: optional complete HTTPS endpoint; blank uses the provider default.
SEARCH_BASE_URL=

# Entire operation including MCP startup. HTTP providers default to 10000 ms.
SEARCH_TIMEOUT_MS=60000

SEARCH_MAX_RESPONSE_BYTES=1048576


# ========================================
# Agent Runtime
# ========================================

AGENT_RUNTIME=dsh

AGENT_MAX_ROUNDS=3

AGENT_MAX_SEARCHES=30

AGENT_MAX_SOURCES=100

AGENT_TIMEOUT_MS=300000

# Required by the production Research Workflow Runtime. Relative paths resolve
# from PRODUCT_SCOUT_ROOT; keep DSH execution state outside PostgreSQL.
DSH_HOME=.dsh-runtime

# Optional DSH provider/model overrides. The pinned DSH default is used when blank.
DSH_PROVIDER=
DSH_MODEL=

# Passed only to the isolated DSH child environment.
DEEPSEEK_API_KEY=
