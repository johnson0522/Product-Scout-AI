# ========================================
# Application
# ========================================

NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ========================================
# Database
# ========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_scout


# ========================================
# Redis
# ========================================

REDIS_URL=redis://localhost:6379


# ========================================
# LLM
# ========================================

LLM_PROVIDER=deepseek

LLM_API_KEY=

LLM_BASE_URL=


# ========================================
# Web Search
# ========================================

# Required for real search: brave or tavily. No automatic mock fallback.
SEARCH_PROVIDER=

SEARCH_API_KEY=

# Optional complete HTTPS search endpoint; blank uses the provider default.
SEARCH_BASE_URL=

SEARCH_TIMEOUT_MS=10000

SEARCH_MAX_RESPONSE_BYTES=1048576


# ========================================
# Agent Runtime
# ========================================

AGENT_RUNTIME=dsh

AGENT_MAX_ROUNDS=3

AGENT_MAX_SEARCHES=30

AGENT_MAX_SOURCES=100

AGENT_TIMEOUT_MS=300000
