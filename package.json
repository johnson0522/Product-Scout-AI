{
  "name": "product-scout",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered product research and opportunity analysis platform",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @product-scout/db generate",
    "db:push": "pnpm --filter @product-scout/db push",
    "db:studio": "pnpm --filter @product-scout/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
