{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@product-scout/ui": [
        "../../packages/ui/src"
      ],
      "@product-scout/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@product-scout/domain": [
        "../../packages/domain/src"
      ],
      "@product-scout/domain/*": [
        "../../packages/domain/src/*"
      ]
    },
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
