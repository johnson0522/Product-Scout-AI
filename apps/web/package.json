{
  "name": "@product-scout/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --env-file=../../.env node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node ../../scripts/assert-test-db.mjs && vitest run tests/full-workflow.postgres.test.ts"
  },
  "dependencies": {
    "@product-scout/agent": "workspace:*",
    "@product-scout/agent-sdk": "workspace:*",
    "@product-scout/domain": "workspace:*",
    "@product-scout/evidence": "workspace:*",
    "@product-scout/db": "workspace:*",
    "@product-scout/research": "workspace:*",
    "@product-scout/ui": "workspace:*",
    "@product-scout/config": "workspace:*",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.1"
  }
}
